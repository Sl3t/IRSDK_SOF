{
  "name": "irsdk-sof-bridge",
  "version": "1.0.0",
  "description": "Node.js bridge: reads iRacing IRSDK shared memory and exposes session data via WebSocket",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "postinstall": "node -e \"const fs=require('fs');const f='node_modules/node-irsdk/binding.gyp';if(fs.existsSync(f)){let c=fs.readFileSync(f,'utf8');if(c.charCodeAt(0)===0xFEFF){c=c.slice(1);fs.writeFileSync(f,c,'utf8');console.log('Fixed BOM in node-irsdk/binding.gyp')}}\""
  },
  "dependencies": {
    "node-irsdk": "^2.1.5",
    "ws": "^8.16.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true,
  "author": "IRSDK SOF Agent",
  "license": "MIT"
}
